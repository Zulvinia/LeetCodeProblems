{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build main.cpp",
      "type": "shell",
      "command": "g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-std=c++20",
        "${workspaceFolder}/main.cpp",
        "-o",
        "${workspaceFolder}/main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}